{
  "name": "sqlite-napi",
  "version": "1.3.0",
  "description": "High-performance SQLite library for Node.js and Bun that mirrors the bun:sqlite API",
  "keywords": [
    "sqlite",
    "napi",
    "node-addon",
    "native",
    "rust",
    "bun",
    "database"
  ],
  "homepage": "https://github.com/nglmercer/sqlite-napi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nglmercer/sqlite-napi.git"
  },
  "bugs": {
    "url": "https://github.com/nglmercer/sqlite-napi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "nglmercer",
    "email": "nglmercer@gmail.com"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "build:all": "bun ./scripts/build_multiplatform.ts",
    "build:debug": "bun ./scripts/build.ts --debug",
    "clean": "napi clean && cargo clean",
    "test": "bun test",
    "bench": "bun run benchmarks/all.ts",
    "dev": "bun run --watch examples/dev.ts",
    "type-check": "tsc --noEmit",
    "format": "bun run --filter ./examples --filter ./scripts format",
    "lint": "rustup run stable cargo clippy -- -D warnings"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@types/bun": "^1.4.0",
    "commander": "^15.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "napi": {
    "binaryName": "sqlite-napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "packageManager": "bun@1.4.0"
}
